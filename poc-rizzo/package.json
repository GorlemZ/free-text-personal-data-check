{
  "name": "node-rizzo-pii-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
    "test": "npm run build && node --test ../tests/rizzo/*.test.mjs",
    "start": "node dist/index.js",
    "prefetch": "node dist/scripts/prefetch.js",
    "smoke": "node dist/scripts/smoke.js"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "ibantools": "4.5.4",
    "onnxruntime-node": "1.30.0"
  }
}
