{
  "name": "node-rizzo-pii-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "prebuild": "pnpm --filter @pagopa/detector-http build",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc",
    "test": "pnpm build && node --test ../tests/rizzo/*.test.mjs",
    "start": "node dist/index.js",
    "prefetch": "node dist/scripts/prefetch.js",
    "smoke": "node dist/scripts/smoke.js"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@pagopa/detector-http": "workspace:*",
    "onnxruntime-node": "1.30.0",
    "p-limit": "6.2.0",
    "raw-body": "2.5.2"
  }
}
