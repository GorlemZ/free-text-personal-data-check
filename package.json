{
  "name": "free-text-personal-data-check",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm --filter @pagopa/detector-http build && pnpm --filter './poc-*' build",
    "typecheck": "pnpm --filter @pagopa/detector-http typecheck && pnpm --filter './poc-*' typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test:horizon": "pnpm --filter poc-horizon-pii-check test",
    "test:bardsai": "pnpm --filter poc-bardsai-pii-check test",
    "test": "pnpm test:horizon && pnpm test:rizzo && pnpm test:bardsai",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test:rizzo": "pnpm --filter node-rizzo-pii-spike test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "typescript-eslint": "8.46.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node",
      "sharp"
    ]
  }
}
