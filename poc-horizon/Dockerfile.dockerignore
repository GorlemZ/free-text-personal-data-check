# Root-context BuildKit allowlist: only this service and workspace build inputs.
*
!package.json
!pnpm-workspace.yaml
!pnpm-lock.yaml
!packages
packages/*
!packages/detector-http
packages/detector-http/*
!packages/detector-http/package.json
!packages/detector-http/tsconfig.json
!packages/detector-http/src
!packages/detector-http/src/**
!poc-bardsai
poc-bardsai/*
!poc-horizon
poc-horizon/*
!poc-rizzo
poc-rizzo/*
!poc-bardsai/package.json
!poc-horizon/package.json
!poc-rizzo/package.json
!poc-horizon/tsconfig.json
!poc-horizon/src
!poc-horizon/src/**
!poc-horizon/model-manifest.json
!poc-horizon/models
!poc-horizon/models/**
**/.env
**/.env.*
**/.npmrc
**/.git
**/.ssh
**/*.pem
**/*.key
**/node_modules
**/.venv
**/__pycache__
**/*.partial
**/.downloads
**/logs
