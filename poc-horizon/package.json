{
  "name": "poc-horizon-pii-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prefetch": "node dist/scripts/prefetch.js",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --test ../tests/horizon/*.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "libphonenumber-js": "1.13.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
