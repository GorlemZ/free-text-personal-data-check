{
  "name": "poc-horizon-pii-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prefetch": "node scripts/prefetch.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "start": "npm run build && node src/server.mjs",
    "test": "npm run build && node --test ../tests/horizon/*.test.mjs",
    "bench": "npm run build && node ../tests/bench/horizon/benchmark.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "libphonenumber-js": "1.13.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
